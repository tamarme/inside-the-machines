# Optional. Use only an owner-approved, read-only aggregate metrics endpoint.
# Keep provider credentials in Athena. Never prefix these variables with NEXT_PUBLIC_.
ATHENA_PUBLIC_METRICS_URL=
ATHENA_PUBLIC_METRICS_TOKEN=

# Alternative: reuse only Inside the Machine's project-scoped Meta credentials.
# Set the API version already used by Athena, rather than copying its global tokens.
META_INSIDE_THE_MACHINE_PAGE_ID=
META_INSIDE_THE_MACHINE_INSTAGRAM_ID=
META_INSIDE_THE_MACHINE_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v26.0

# Optional YouTube statistics, using the existing Inside the Machine channel connection.
# All four values remain server-only. No API key or new OAuth grant is created here.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_INSIDE_THE_MACHINE_CHANNEL_ID=
YOUTUBE_INSIDE_THE_MACHINE_REFRESH_TOKEN=
